  "item": [
    {
      "name": "00. Autenticación (OAuth 2.0)",
      "item": [
        {
          "name": "POST /api/Auth/token (Obtener Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('authToken', json.access_token);",
                  "    console.log('✅ Token JWT actualizado en authToken');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{clientId}}\",\n  \"client_secret\": \"{{clientSecret}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Auth", "token"]
            },
            "description": "Emite el token OAuth 2.0 JWT HS256 con vigencia de 24 horas para las transacciones ASBANC."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. On-Host Transaccional (FTR / YAPAGO)",
      "item": [
        {
          "name": "Paso 1: Validar Cliente (ValidateCustomer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Código respuesta es 00', function () {",
                  "    pm.expect(json.codigoRespuesta).to.eql('00');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoConsulta\": \"1\",\n  \"idConsulta\": \"{{codigoAlumno}}\",\n  \"codigoEmpresa\": \"{{codigoEmpresa}}\",\n  \"codigoProducto\": \"001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Transactional/ValidateCustomer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Transactional", "ValidateCustomer"]
            }
          },
          "response": []
        },
        {
          "name": "Paso 2: Consultar Deudas (ListDebts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Código respuesta es 00', function () {",
                  "    pm.expect(json.codigoRespuesta).to.eql('00');",
                  "});",
                  "if (json.deudasPendientes && json.deudasPendientes.length > 0) {",
                  "    const deuda = json.deudasPendientes[0];",
                  "    pm.collectionVariables.set('numDocumento', deuda.numDocumento);",
                  "    pm.collectionVariables.set('importeDeuda', deuda.importeDeuda.toString());",
                  "    console.log('✅ Deuda capturada: Documento=' + deuda.numDocumento + ', Monto=' + deuda.importeDeuda);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoConsulta\": \"1\",\n  \"idConsulta\": \"{{codigoAlumno}}\",\n  \"codigoEmpresa\": \"{{codigoEmpresa}}\",\n  \"codigoProducto\": \"001\",\n  \"codigoBanco\": \"{{codigoBanco}}\",\n  \"canalPago\": \"{{canalPago}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Transactional/ListDebts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Transactional", "ListDebts"]
            }
          },
          "response": []
        },
        {
          "name": "Paso 3: Notificar Pago (PayDebt)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(10000000 + Math.random() * 90000000);",
                  "pm.collectionVariables.set('numOperacionBanco', 'OP' + randomNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Código respuesta es 00', function () {",
                  "    pm.expect(json.codigoRespuesta).to.eql('00');",
                  "});",
                  "if (json.numOperacionERP) {",
                  "    pm.collectionVariables.set('numOperacionERP', json.numOperacionERP);",
                  "    console.log('✅ Pago confirmado: numOperacionERP=' + json.numOperacionERP);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaTxn\": \"{{fechaTxn}}\",\n  \"horaTxn\": \"{{horaTxn}}\",\n  \"canalPago\": \"{{canalPago}}\",\n  \"codigoBanco\": \"{{codigoBanco}}\",\n  \"numOperacionBanco\": \"{{numOperacionBanco}}\",\n  \"formaPago\": \"{{formaPago}}\",\n  \"tipoConsulta\": \"{{tipoConsulta}}\",\n  \"idConsulta\": \"{{codigoAlumno}}\",\n  \"codigoProducto\": \"001\",\n  \"numDocumento\": \"{{numDocumento}}\",\n  \"importePagado\": {{importeDeuda}},\n  \"monedaDoc\": \"1\",\n  \"codigoEmpresa\": \"{{codigoEmpresa}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Transactional/PayDebt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Transactional", "PayDebt"]
            }
          },
          "response": []
        },
        {
          "name": "Paso 4: Validar Idempotencia (Reintento de PayDebt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Código respuesta es 00 en reintento (idempotencia)', function () {",
                  "    pm.expect(json.codigoRespuesta).to.eql('00');",
                  "});",
                  "pm.test('Retorna el mismo numOperacionERP previo', function () {",
                  "    pm.expect(json.numOperacionERP).to.eql(pm.collectionVariables.get('numOperacionERP'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaTxn\": \"{{fechaTxn}}\",\n  \"horaTxn\": \"{{horaTxn}}\",\n  \"canalPago\": \"{{canalPago}}\",\n  \"codigoBanco\": \"{{codigoBanco}}\",\n  \"numOperacionBanco\": \"{{numOperacionBanco}}\",\n  \"formaPago\": \"{{formaPago}}\",\n  \"tipoConsulta\": \"{{tipoConsulta}}\",\n  \"idConsulta\": \"{{codigoAlumno}}\",\n  \"codigoProducto\": \"001\",\n  \"numDocumento\": \"{{numDocumento}}\",\n  \"importePagado\": {{importeDeuda}},\n  \"monedaDoc\": \"1\",\n  \"codigoEmpresa\": \"{{codigoEmpresa}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Transactional/PayDebt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Transactional", "PayDebt"]
            }
          },
          "response": []
        },
        {
          "name": "Paso 5: Revertir / Extornar Pago (ReversePay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Código respuesta es 00', function () {",
                  "    pm.expect(json.codigoRespuesta).to.eql('00');",
                  "});",
                  "console.log('✅ Pago extornado y base de datos restaurada intacta.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaTxn\": \"{{fechaTxn}}\",\n  \"horaTxn\": \"{{horaTxn}}\",\n  \"codigoBanco\": \"{{codigoBanco}}\",\n  \"tipoConsulta\": \"{{tipoConsulta}}\",\n  \"idConsulta\": \"{{codigoAlumno}}\",\n  \"numOperacionBanco\": \"{{numOperacionBanco}}\",\n  \"numDocumento\": \"{{numDocumento}}\",\n  \"codigoEmpresa\": \"{{codigoEmpresa}}\",\n  \"formaPago\": \"{{formaPago}}\",\n  \"importePagado\": {{importeDeuda}},\n  \"monedaDoc\": \"1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Transactional/ReversePay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Transactional", "ReversePay"]
            }
          },
          "response": []
        }
      ]
    },
