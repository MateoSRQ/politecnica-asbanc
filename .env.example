# ==========================================================
# POLITECNICA ASBANC - CONFIGURACIÓN DE ENTORNO DE EJEMPLO
# Copiar este archivo a .env y configurar credenciales seguras
# ==========================================================

# Servidor HTTP / Fastify
NODE_ENV=development
PORT=7300
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Modo de Pruebas / Certificación y Fallback Sintético
# 'false' en producción (aislamiento 100% sobre BDACADEMICO6). 'true' en tests/homologación.
TEST_MODE=false

# Seguridad y Autenticación ASBANC
ASBANC_AUTH_ENABLED=true
ASBANC_AUTH_SECRET=configure_un_hash_o_secreto_seguro_aqui
ASBANC_DEFAULT_COMPANY_CODE=998
JWT_SECRET=configure_una_clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios
JWT_EXPIRATION_SECONDS=86400
ASBANC_CLIENT_ID=asbanc_ftr
ASBANC_CLIENT_SECRET=configure_un_secreto_cliente_seguro_aqui

# Base de Datos Microsoft SQL Server 2022 (Instancia Nativa en Host)
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=configure_su_password_mssql_segura
DB_NAME=BDACADEMICO6
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=15000
DB_POOL_MIN=50
DB_POOL_MAX=100

# Telemetría y Métricas (Prometheus)
METRICS_ENABLED=true
METRICS_ROUTE=/metrics
SLA_WARNING_THRESHOLD_MS=2500

# Rate Limiting (Prevención de DDoS y Fuerza Bruta)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=10000

# Webhooks de Notificación Transaccional
PAYMENT_WEBHOOK_URL=
