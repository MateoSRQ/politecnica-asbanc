# ==========================================================
# POLITECNICA ASBANC - CONFIGURACIÓN DE ENTORNO
# Usando Microsoft SQL Server 2022 NATIVO en el host
# ==========================================================

# Servidor HTTP / Fastify
NODE_ENV=development
PORT=7300
HOST=0.0.0.0
LOG_LEVEL=info

# Seguridad y Autenticación ASBANC
ASBANC_AUTH_ENABLED=true
ASBANC_AUTH_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3NDgxMjEyMDMsImlzcyI6Imlz
ASBANC_DEFAULT_COMPANY_CODE=998

# Base de Datos Microsoft SQL Server 2022 (Instancia Nativa en Host)
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=tu_password_mssql
DB_NAME=politecnica_asbanc
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=5000
DB_REQUEST_TIMEOUT=5000
DB_POOL_MIN=5
DB_POOL_MAX=30

# Telemetría y Métricas (Prometheus)
METRICS_ENABLED=true
METRICS_ROUTE=/metrics
SLA_WARNING_THRESHOLD_MS=2500
